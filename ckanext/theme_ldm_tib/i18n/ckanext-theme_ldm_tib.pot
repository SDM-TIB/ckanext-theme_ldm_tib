#: ckanext/theme_ldm_tib/templates/home/api.html:22
msgid "Service for Data Comparison"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:22
msgid ""
"This API enables direct side-by-side comparison of CSV datasets. Upload two or more CSV files, join them on a shared key column, and explore the result in a "
"filterable table. Visualisations can be rendered as line, scatter, or bar charts with an optional logarithmic scale."
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:24
msgid "Incremental resource loading — start with a single CSV and join additional files one at a time"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:25
msgid "Automatic left-join on the first shared column across datasets"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:26
msgid "Filterable table with column-level search and pagination (DataTables)"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:27
msgid "Interactive charts with selectable series and filtering to currently visible rows (Plotly)"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:28
msgid "Available as a Docker container or a local Python application"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:30 ckanext/theme_ldm_tib/templates/home/api.html:41 ckanext/theme_ldm_tib/templates/home/api.html:50
