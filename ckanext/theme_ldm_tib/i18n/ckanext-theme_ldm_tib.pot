msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:39
msgid "Unified REST API on a single port for all operations"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:44
msgid "Service for Knowledge Graph Creation"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:44
msgid ""
"This API transforms heterogeneous data sources into RDF knowledge graphs using SDM-RDFizer executed with RML mappings. RML (RDF Mapping Language) is a "
"declarative language for defining how data elements from sources such as CSV, JSON, or XML correspond to RDF subjects, predicates, and objects. The API "
"allows users to submit datasets and RML mapping rules, automatically execute the transformation process, and output the resulting knowledge graph to a "
"specified folder."
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:46
msgid "Supports heterogeneous source formats (CSV, JSON, XML, relational databases)"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:47
msgid "Automated RDF triple generation based on RML mapping rules"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:48
msgid "Knowledge graph output to a configurable folder"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:53
msgid "Service for Knowledge Graph Integration"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:53
msgid ""
"This API maps dataset metadata properties to those defined in a mapping template. The purpose of this service is to map dataset metadata to the structure "
"required by the dataset template of the Leibniz Data Manager (LDM), facilitating easier import of datasets into the platform."
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:55
msgid "User-defined mapping templates for linking existing metadata properties"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:56
msgid "Support for nested metadata structures via iterator configuration"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:57
msgid "Generates a structured output file compatible with the LDM dataset template"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:62
msgid "Service for Knowledge Graph Exploration"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:62
