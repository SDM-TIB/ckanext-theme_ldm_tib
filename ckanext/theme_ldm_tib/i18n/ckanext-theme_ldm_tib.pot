#: ckanext/theme_ldm_tib/templates/home/api.html:33
msgid "Service for Jupyter Notebook Execution"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:33
msgid ""
"A containerised, multi-user JupyterHub instance with a unified REST API for notebook management. Designed for integration into external applications that "
"need to spawn temporary Jupyter environments and serve notebooks to end users."
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:35
msgid "Configurable pool of guest users for concurrent sessions (e.g. <code>guest0..guestN</code>)"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:36
msgid "Automatic cleanup of idle servers with configurable timeouts and kernel lifecycle management"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:37
msgid "Per-container resource limits for CPU, memory, and disk"
msgstr ""

#: ckanext/theme_ldm_tib/templates/home/api.html:38
